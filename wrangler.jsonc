{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "corect",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "containers": [
    {
      "class_name": "CorectContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CORECT_CONTAINER",
        "class_name": "CorectContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CorectContainer"]
    }
  ]
}
