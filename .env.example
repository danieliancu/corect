DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins for tunnels or proxies that end HTTPS in front of Django, e.g. https://name.ngrok-free.dev
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_NAME=englishcoach
DATABASE_USER=englishcoach
DATABASE_PASSWORD=englishcoach-local
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=60
# Optional JSON price table in USD per 1M tokens; replaces the built-in gpt-5.6-luna prices. {} disables cost estimates.
# Example: {"gpt-5.6-luna": {"input_per_1m": "0.20", "cached_input_per_1m": "0.02", "output_per_1m": "1.20"}}
OPENAI_PRICING=
ANALYTICS_VISITOR_COOKIE=true
ASSISTANT_MAX_CHARACTERS=2000
RATE_LIMIT_MINUTE=10
RATE_LIMIT_DAY=100
