DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins for tunnels or proxies that end HTTPS in front of Django, e.g. https://name.ngrok-free.dev
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_NAME=englishcoach
DATABASE_USER=englishcoach
DATABASE_PASSWORD=englishcoach-local
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=60
# Optional JSON price table in USD per 1M tokens; replaces the built-in gpt-5.6-luna prices. {} disables cost estimates.
# Example: {"gpt-5.6-luna": {"input_per_1m": "0.20", "cached_input_per_1m": "0.02", "output_per_1m": "1.20"}}
OPENAI_PRICING=
ANALYTICS_VISITOR_COOKIE=true
# Voice: a recording is transcribed after it stops; British English speech is generated only when Listen is pressed.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_SPEED=1.0
VOICE_MAX_SECONDS=60
VOICE_MAX_BYTES=5000000
VOICE_TRANSCRIBE_LANGUAGES=en,ro
VOICE_TRANSCRIBE_LIMIT_MINUTE=5
VOICE_TRANSCRIBE_LIMIT_DAY=50
VOICE_TTS_LIMIT_MINUTE=10
VOICE_TTS_LIMIT_DAY=100
VOICE_SPEECH_TOKEN_MAX_AGE=2700
# Optional JSON audio price table in USD; replaces the built-in gpt-transcribe and gpt-4o-mini-tts prices. {} leaves audio costs unknown.
# Example: {"gpt-transcribe": {"per_minute": "0.0045"}, "gpt-4o-mini-tts": {"input_per_1m": "0.60", "output_per_1m": "12.00"}}
OPENAI_AUDIO_PRICING=
ASSISTANT_MAX_CHARACTERS=2000
RATE_LIMIT_MINUTE=10
RATE_LIMIT_DAY=100
