DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins for tunnels or proxies that end HTTPS in front of Django, e.g. https://name.ngrok-free.dev
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_NAME=englishcoach
DATABASE_USER=englishcoach
DATABASE_PASSWORD=englishcoach-local
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=60
# Seconds the shared OpenAI connection stays open between requests, so a new request skips the TLS handshake.
OPENAI_KEEPALIVE_SECONDS=20
# Empty = the model's default. minimal, low, medium or high: run eval_naturalize --live before changing it.
OPENAI_REASONING_EFFORT=
# Optional JSON price table in USD per 1M tokens; replaces the built-in gpt-5.6-luna prices. {} disables cost estimates.
# Example: {"gpt-5.6-luna": {"input_per_1m": "0.20", "cached_input_per_1m": "0.02", "output_per_1m": "1.20"}}
OPENAI_PRICING=
ANALYTICS_VISITOR_COOKIE=true
# Staff analytics show costs in pounds: GBP per 1 USD (OpenAI bills in USD; ledgers keep USD).
ANALYTICS_GBP_PER_USD=0.74
# Voice input: live transcription in the browser (words appear while speaking). false = kill switch: record, stop, then
# transcribe the finished recording with OPENAI_TRANSCRIBE_MODEL, which is also the fallback when live cannot start.
VOICE_REALTIME_ENABLED=true
OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# British English speech is generated only when a speaker button is pressed.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_SPEED=1.0
VOICE_MAX_SECONDS=60
VOICE_MAX_BYTES=5000000
VOICE_TRANSCRIBE_LANGUAGES=en,ro
# Live transcription latency (see README, Latency). Delay: low by default; empty sends none.
VOICE_REALTIME_DELAY=low
# After Stop, the microphone stays on this long (ms) for a word still being spoken, then the audio is committed.
VOICE_TRAILING_AUDIO_MS=200
# Safety limit (ms) for the final transcript after the commit; the wait normally ends when the final event arrives.
VOICE_FINAL_TRANSCRIPT_MS=2500
# Voice guardrails (technical, never the plan quota): calls per minute, and per London day for anonymous,free,pro.
VOICE_TRANSCRIBE_LIMIT_MINUTE=5
VOICE_TRANSCRIBE_DAY_LIMITS=20,80,400
VOICE_TTS_LIMIT_MINUTE=10
VOICE_TTS_DAY_LIMITS=30,120,600
VOICE_SPEECH_TOKEN_MAX_AGE=2700
# Optional JSON audio price table in USD; replaces all built-in audio prices. {} leaves audio costs unknown.
# Example: {"gpt-live-transcribe": {"per_minute": "0.017"}, "gpt-transcribe": {"per_minute": "0.0045"}, "gpt-4o-mini-tts": {"input_per_1m": "0.60", "output_per_1m": "12.00"}}
OPENAI_AUDIO_PRICING=
ASSISTANT_MAX_CHARACTERS=2000
# Plan quota: successful „Vreau să sune natural!” uses per London calendar day. Typed and spoken text count the same;
# the microphone and British speech never count. Must not decrease from anonymous to free to pro.
NATURALIZE_ANONYMOUS_LIMIT_DAY=5
NATURALIZE_FREE_LIMIT_DAY=20
NATURALIZE_PRO_LIMIT_DAY=200
# Technical rate limit (anti-abuse), not the plan: "Vreau să sune natural!" requests per minute per actor.
NATURALIZE_RATE_LIMIT_MINUTE=10
# Abuse guardrail: every submitted text is checked with OpenAI's free moderation endpoint in parallel with the model
# call (no extra waiting); flagged text is refused. Keep true in production.
CONTENT_MODERATION_ENABLED=true
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Public contact address; the Contact page and footer link appear only when it is set.
CONTACT_EMAIL=
# Pro price shown on the homepage plans. Display only: payments are not implemented yet (daily plan limits are).
PRO_DISPLAY_PRICE=£9.99
# With the promotion on, PRO_DISPLAY_PRICE is shown struck through beside PRO_PROMO_PRICE / lună.
PRO_PROMO_ENABLED=true
PRO_PROMO_PRICE=£4.99
# Legal identity shown in the Terms, the Privacy notice, Contact and the footer. Never invent values: leave empty what
# you do not have. With DJANGO_DEBUG=false, LEGAL_OPERATOR_NAME, LEGAL_SERVICE_ADDRESS and CONTACT_EMAIL are required.
# LEGAL_OPERATOR_TYPE: sole_trader (an individual trading as Corect.uk) or company (then set COMPANY_NUMBER).
LEGAL_OPERATOR_TYPE=sole_trader
LEGAL_OPERATOR_NAME=
LEGAL_TRADING_NAME=Corect.uk
LEGAL_SERVICE_ADDRESS=
LEGAL_JURISDICTION=England and Wales
LEGAL_COUNTRY=United Kingdom
COMPANY_NUMBER=
VAT_NUMBER=
# Optional: named as a recipient in the Privacy notice once chosen.
LEGAL_HOSTING_PROVIDER=
